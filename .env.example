# 32 bytes or more. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CONTACTBOT_SECRET=replace-with-a-long-random-secret
CONTACTBOT_DB=./data/contactbot.sqlite3
CONTACTBOT_DISPLAY_NAME=好友助手
CONTACTBOT_ACCOUNTS_DIR=./accounts

# Comma-separated Delta Chat addresses. These become system administrators
# after they privately message the bot. Matching uses an HMAC identity digest.
CONTACTBOT_SYSTEM_ADMINS=admin@example.org
# Optional migration/backup binding to stable Delta Chat Core contact IDs.
CONTACTBOT_SYSTEM_ADMIN_CONTACT_IDS=

# Optional existing account id. Defaults to the first configured account.
CONTACTBOT_ACCOUNT_ID=
CONTACTBOT_RPC_SERVER=deltachat-rpc-server
CONTACTBOT_REQUIRE_VERIFIED=true
CONTACTBOT_ADMIN_WEB_TOKEN=replace-with-an-independent-random-token-at-least-32-characters
CONTACTBOT_ADMIN_WEB_PORT=8787
# Used only by `contactbot seed-network`; remove after seeding when practical.
CONTACTBOT_INITIAL_NETWORK_CODE=
# Optional Docker host bind paths, useful when upgrading an existing deployment.
CONTACTBOT_DATA_HOST_PATH=./data
CONTACTBOT_ACCOUNT_HOST_PATH=./runtime/account
CONTACTBOT_RPC_HOST_PATH=./runtime/bin
CONTACTBOT_LOG_LEVEL=INFO
