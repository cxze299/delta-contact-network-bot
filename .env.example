CONTACTBOT_SECRET=replace-with-at-least-32-random-characters
CONTACTBOT_XDC_ADMIN_VERIFIER=250000:replace-with-32-hex-salt:replace-with-64-hex-derived-key
CONTACTBOT_ADMIN_WEB_TOKEN=replace-with-an-independent-random-web-password
CONTACTBOT_BACKUP_PASSWORD=replace-with-an-independent-random-backup-password
CONTACTBOT_BUN_DB=/app/data/bun-contactbot.sqlite3
CONTACTBOT_ACCOUNTS_DIR=/app/account
CONTACTBOT_RPC_SERVER=/app/rpc/deltachat-rpc-server
CONTACTBOT_ASSETS=/app/webxdc
CONTACTBOT_ACCOUNT_ID=
CONTACTBOT_REQUIRE_VERIFIED=true
CONTACTBOT_ADMIN_WEB_BIND=127.0.0.1
CONTACTBOT_ADMIN_WEB_PORT=8787
CONTACTBOT_DATA_HOST_PATH=./data
CONTACTBOT_ACCOUNT_HOST_PATH=./runtime/account
CONTACTBOT_RPC_HOST_PATH=./runtime/bin
